---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets"; // Utilise l'import standard Astro
import hero from "../../assets/images/social_hero.avif";
import editicon from "../../assets/icons/neo_edit.svg";
---

<Layout title="Mon Compte">
    <div class="flex flex-col gap-5">
        <Image src={hero} alt="Hero Image" class="hero" />
        <div class="p-5 flex justify-between relative">
            <div class="relative w-full flex flex-col justify-between">
                <h1 id="profile-tag" class="neo-title text-3xl text-center">
                    Chargement...
                </h1>
                <p class="">
                    <a
                        href="/account/edit"
                        class="flex items-center gap-2 font-semibold mb-2 text-tonique justify-center"
                    >
                        Modifier le profil
                        <span><Image src={editicon} alt="Editer" /></span>
                    </a>
                </p>
                <button
                    id="logout-btn"
                    class="block mx-auto text-red-500 text-sm underline"
                    >Se déconnecter</button
                >
            </div>
            <button
                id="sub-btn"
                class="flex flex-col hover:opacity-80 transition-opacity"
            >
                <img
                    id="sub-img"
                    src="/nosub.svg"
                    alt="Non abonné"
                    class="mx-auto flex-1 opacity-50 object-contain transition-opacity"
                />
                <p
                    id="sub-text"
                    class="text-center text-tonique/75 font-semibold transition-colors"
                >
                    Mocktail+
                </p>
            </button>
        </div>
        <div class="separator"></div>
        <div class="p-5">
            <h2 class="neo-title text-3xl text-center">Vous participez à</h2>
            <ul id="event-list" class="text-center mt-4">
                <li class="text-gray-500">Aucun événement pour le moment.</li>
            </ul>
        </div>
    </div>
</Layout>

<script>
    import {
        isLogged,
        logout,
        deleteEvent,
        refreshAuthStore,
    } from "../../../backend/backend.mjs";

    async function init() {
        const user = await refreshAuthStore();
        if (!user) {
            window.location.href = "/account/login";
            return;
        }

        // 1. Initialisation du profil
        const titleElement = document.getElementById("profile-tag");
        if (titleElement) {
            titleElement.textContent = user.tag;
        }

        document.getElementById("logout-btn")?.addEventListener("click", () => {
            logout();
            window.location.href = "/";
        });

        // 2. Gestion de l'abonnement Stripe (on le fait en premier !)
        const subBtn = document.getElementById("sub-btn");
        const subImg = document.getElementById("sub-img");
        const subText = document.getElementById("sub-text");

        if (user.sub) {
            subImg.src = "/sub.svg";
            subImg.alt = "Abonné Mocktail+";
            subImg.classList.remove("opacity-50");

            subText.classList.remove("text-tonique/75");
            subText.classList.add("text-tonique");

            subBtn.classList.remove("hover:opacity-80");
            subBtn.classList.add("cursor-default");
            subBtn.disabled = true;
        } else {
            subBtn.addEventListener("click", async () => {
                try {
                    subBtn.disabled = true;
                    subImg.classList.add("animate-pulse");

                    const response = await fetch("/api/stripe/checkout", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ id: user.id }),
                    });

                    const data = await response.json();

                    if (data.url) {
                        window.location.href = data.url;
                    } else {
                        console.error("Erreur Stripe:", data.error);
                        subBtn.disabled = false;
                        subImg.classList.remove("animate-pulse");
                    }
                } catch (error) {
                    console.error("Erreur réseau:", error);
                    subBtn.disabled = false;
                    subImg.classList.remove("animate-pulse");
                }
            });
        }
        // 3. Affichage des événements
        const leaderOf = user.leader_of || [];
        const memberOf = user.member_of || [];
        const eventList = document.getElementById("event-list");

        if (leaderOf.length === 0 && memberOf.length === 0) {
            // Pas de "return" ici, on affiche juste le message !
            eventList.innerHTML =
                '<li class="text-gray-500">Aucun événement pour le moment.</li>';
        } else {
            try {
                const response = await fetch("/api/getEvents", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        leader_of: leaderOf,
                        member_of: memberOf,
                    }),
                });

                if (!response.ok)
                    throw new Error(
                        "Erreur lors de la récupération des événements",
                    );

                const events = await response.json();

                if (!Array.isArray(events) || events.length === 0) {
                    eventList.innerHTML =
                        '<li class="text-gray-500">Aucun événement pour le moment.</li>';
                } else {
                    eventList.innerHTML = events
                        .map(
                            (ev) => `
                        <div class="page-btn w-full mb-5 text-start flex justify-between items-center">
                            <a href="/soiree/${ev.id}" class='flex-1'>
                                <h3 class="font-semibold text-lg mb-1">
                                    ${ev.name || "SOIRÉE"} • ${ev.multi_bar ? "Multi-Bar" : "Bar"}
                                </h3>
                                <div class="text-sm space-y-0.5">
                                    <p>Organisé par : ${ev.expand?.leader?.tag || "XXXX"}</p>
                                    <p>${ev.date ? new Date(ev.date).toLocaleDateString("fr-FR") : "Date à programmer"}</p>
                                    <p>Participants : ${ev.members?.length || 0}</p> 
                                </div>
                            </a>
                            <button class="text-white opacity-80 hover:opacity-100 p-2 delete_btn" data-id="${ev.id}">
                                <img src="/delete.svg" alt="Supprimer">
                            </button>
                        </div>
                    `,
                        )
                        .join("");
                    const deleteBtns = document.querySelectorAll(".delete_btn");
                    deleteBtns.forEach((btn) => {
                        const evid = btn.getAttribute("data-id");
                        btn.addEventListener("click", () => {
                            deleteEvent(evid);
                            window.location.reload();
                        });
                    });
                }
            } catch (err) {
                eventList.innerHTML =
                    '<li class="text-red-500">Erreur lors de la récupération des événements</li>';
            }
        }
    }

    init();
</script>
