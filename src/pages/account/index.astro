---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets"; // Utilise l'import standard Astro
import hero from "../../assets/images/social_hero.avif";
import editicon from "../../assets/icons/neo_edit.svg";
---

<Layout title="Mon Compte">
    <div class="flex flex-col gap-5">
        <Image src={hero} alt="Hero Image" class="hero" />
        <div class="p-5">
            <h1 id="profile-tag" class="neo-title text-3xl text-center">
                Chargement...
            </h1>
            <p class="">
                <a
                    href="/account/edit"
                    class="flex items-center gap-2 font-semibold mb-2 text-tonique justify-center"
                >
                    Modifier le profil
                    <span><Image src={editicon} alt="Editer" /></span>
                </a>
            </p>
            <button
                id="logout-btn"
                class="block mx-auto text-red-500 text-sm underline mb-5"
                >Se déconnecter</button
            >
            <div class="separator"></div>
        </div>

        <div class="p-5">
            <h2 class="neo-title text-3xl text-center">Vous participez à</h2>
            <ul id="event-list" class="text-center mt-4">
                <li class="text-gray-500">Aucun événement pour le moment.</li>
            </ul>
        </div>
    </div>
</Layout>

<script>
    import { isLogged, logout } from "../../../backend/backend.mjs";

    async function init() {
        const user = await isLogged();
        if (!user) {
            window.location.href = "/account/login";
            return;
        }

        const titleElement = document.getElementById("profile-tag");
        if (titleElement) {
            titleElement.textContent = user.tag;
        }

        document.getElementById("logout-btn")?.addEventListener("click", () => {
            logout();
            window.location.href = "/";
        });

        // Affichage des événements
        const leaderOf = user.leader_of || [];
        const memberOf = user.member_of || [];
        const eventList = document.getElementById("event-list");
        if (leaderOf.length === 0 && memberOf.length === 0) {
            eventList.innerHTML =
                '<li class="text-gray-500">Aucun événement pour le moment.</li>';
            return;
        }
        try {
            const response = await fetch("/api/getEvents", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    leader_of: leaderOf,
                    member_of: memberOf,
                }),
            });
            if (!response.ok)
                throw new Error(
                    "Erreur lors de la récupération des événements",
                );
            const events = await response.json();
            if (!Array.isArray(events) || events.length === 0) {
                eventList.innerHTML =
                    '<li class="text-gray-500">Aucun événement pour le moment.</li>';
                return;
            }
            eventList.innerHTML = events
                .map(
                    (ev) =>
                        `
        <a href="/soiree/${ev.id}" class="page-btn w-full mb-5 text-start flex justify-between items-center">
            
            <div>
                <h3 class="font-semibold text-lg mb-1">
                    ${ev.name || "SOIRÉE"} • ${ev.multi_bar ? "Multi-Bar" : "Bar"}
                </h3>
                <div class="text-sm space-y-0.5">
                    <p>Organisé par : ${ev.expand?.leader?.tag || "XXXX"}</p>
                    <p>${ev.date ? new Date(ev.date).toLocaleDateString("fr-FR") : "Date à programmer"}</p>
                    <p>Participants : ${ev.members.length + 1}</p>
                </div>
            </div>

            <button class="text-white opacity-80 hover:opacity-100 p-2" onclick="deleteEvent('${ev.id}')">
                <img src="" alt="">
            </button>

        </a>
        `,
                )
                .join("");
        } catch (err) {
            eventList.innerHTML =
                '<li class="text-red-500">Erreur lors de la récupération des événements</li>';
        }
    }

    init();
</script>
