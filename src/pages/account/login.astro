---
import Layout from "../../layouts/loginLayout.astro";
import Image from "astro/components/Image.astro";
import logo from "../../assets/icons/logo.svg";
import email from "../../assets/icons/mail.svg";
import pwd from "../../assets/icons/pw.svg";
---

<Layout title="Connexion">
    <main class="w-full max-w-md p-6 mt-10 mx-auto">
        <div class="p-8 flex flex-col items-center gap-5">
            <a href="/" class="mb-6 block transition-transform hover:scale-105">
                <Image src={logo} alt="logo image" />
            </a>

            <div class="flex flex-col items-center">
                <h1 class="text-3xl mb-2 font-bold">Connexion</h1>
                <p class="text-sm text-gray-400">
                    Pas encore de compte ? <a
                        href="/account/register"
                        class="text-secondaire font-semibold hover:underline"
                        >Créez en un</a
                    >
                </p>
            </div>

            <form class="w-full mt-8 space-y-4" id="login-form">
                <div class="relative">
                    <span
                        class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                    >
                        <Image src={email} alt="" />
                    </span>
                    <input
                        name="email"
                        type="email"
                        placeholder="adresse@gmail.com"
                        required
                        class="w-full pl-10 pr-4 py-3 rounded-lg bg-white text-black focus:outline-hidden focus:ring-2 focus:ring-secondaire/50 transition-shadow"
                    />
                </div>

                <div class="relative">
                    <span
                        class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                    >
                        <Image src={pwd} alt="" />
                    </span>
                    <input
                        name="password"
                        type="password"
                        placeholder="*******"
                        required
                        class="w-full pl-10 pr-10 py-3 rounded-lg bg-white text-black focus:outline-hidden focus:ring-2 focus:ring-secondaire/50 transition-shadow"
                    />
                </div>

                <div class="text-center">
                    <a
                        href="/account/ForgetPWD"
                        class="text-xs text-gray-400 hover:text-white transition-colors underline"
                        >Mot de Passe oublié ?</a
                    >
                </div>

                <!-- 🎨 Conteneur d'erreur stylisé, masqué par défaut -->
                <div
                    id="errorMessage"
                    class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm p-3 rounded-xl text-center font-medium animate-fade-in"
                >
                </div>

                <button
                    id="submit-btn"
                    class="action-btn w-full flex justify-center items-center gap-2 py-3 rounded-lg transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
                    type="submit"
                >
                    <span id="submit-text">Connectez Vous</span>
                </button>
            </form>
        </div>
    </main>
</Layout>

<script>
    import { Userauth } from "../../../backend/backend.mjs";

    const form = document.getElementById("login-form") as HTMLFormElement;
    const errorMsg = document.getElementById("errorMessage");
    const submitBtn = document.getElementById(
        "submit-btn",
    ) as HTMLButtonElement;
    const submitText = document.getElementById("submit-text");

    // Fonction centralisée pour afficher les erreurs avec clarté
    function displayError(message: string) {
        if (errorMsg) {
            errorMsg.textContent = message;
            errorMsg.classList.remove("hidden");
        }
    }

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        // 1. Reset de l'état d'erreur précédent
        errorMsg?.classList.add("hidden");

        // 2. Activation du loader visuel (UX++)
        if (submitBtn && submitText) {
            submitBtn.disabled = true;
            submitText.textContent = "Connexion en cours...";
        }

        const formData = new FormData(form);
        const email = formData.get("email") as string;
        const password = formData.get("password") as string;

        try {
            const auth = await Userauth(email, password);

            if (auth) {
                window.location.href = "/account";
            } else {
                displayError(
                    "Identifiants incorrects. Veuillez vérifier votre email et mot de passe.",
                );
            }
        } catch (err) {
            // Gestion des pannes de réseau ou de serveur PocketBase
            displayError(
                "Une erreur réseau est survenue. Veuillez réessayer ultérieurement.",
            );
        } finally {
            // 3. Restauration du bouton si la connexion a échoué
            if (submitBtn && submitText) {
                submitBtn.disabled = false;
                submitText.textContent = "Connectez Vous";
            }
        }
    });

    form?.querySelectorAll("input").forEach((input) => {
        input.addEventListener("input", () => {
            errorMsg?.classList.add("hidden");
        });
    });
</script>
