---
import Layout from "../../layouts/loginLayout.astro";
import Image from "astro/components/Image.astro";
import logo from "../../assets/icons/logo.svg";
import email from "../../assets/icons/mail.svg";
import pwd from "../../assets/icons/pw.svg";
---

<Layout title="Inscription">
    <main class="w-full max-w-md p-6">
        <div class="p-8 flex flex-col items-center gap-5">
            <div class="">
                <Image src={logo} alt="logo image" />
            </div>

            <div class="flex flex-col items-center">
                <h1 class="text-3xl mb-2">Inscription</h1>
                <p class="text-sm">
                    Déjà un compte ? <a
                        href="/account/login"
                        class="text-secondaire">Connectez vous</a
                    >
                </p>
            </div>

            <form class="w-full mt-8 space-y-5" id="registerForm">
                <div class="space-y-2">
                    <p>Informations publique</p>
                    <div class="relative">
                        <span
                            class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                        >
                            <Image src={email} alt="" />
                        </span>
                        <input
                            type="text"
                            name="pseudo"
                            placeholder="pseudo"
                            required
                            class="w-full pl-10 pr-4 py-3 rounded-lg bg-white text-black focus:outline-none"
                        />
                    </div>
                </div>
                <div class="space-y-2">
                    <p>Informations personnelles</p>
                    <div class="relative">
                        <span
                            class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                        >
                            <Image src={email} alt="" />
                        </span>
                        <input
                            type="text"
                            placeholder="prenom"
                            name="prename"
                            required
                            class="w-full pl-10 pr-4 py-3 rounded-lg bg-white text-black focus:outline-none"
                        />
                    </div>
                    <div class="relative">
                        <span
                            class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                        >
                            <Image src={email} alt="" />
                        </span>
                        <input
                            type="text"
                            placeholder="nom"
                            name="name"
                            required
                            class="w-full pl-10 pr-4 py-3 rounded-lg bg-white text-black focus:outline-none"
                        />
                    </div>
                </div>
                <div class="space-y-2">
                    <p>Informations de connexion</p>
                    <div class="relative">
                        <span
                            class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                        >
                            <Image src={email} alt="" />
                        </span>
                        <input
                            type="email"
                            name="email"
                            placeholder="adresse@gmail.com"
                            required
                            class="w-full pl-10 pr-4 py-3 rounded-lg bg-white text-black focus:outline-none"
                        />
                    </div>

                    <div class="relative">
                        <span
                            class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                        >
                            <Image src={pwd} alt="" />
                        </span>
                        <input
                            type="password"
                            name="password"
                            placeholder="Mot de passe"
                            required
                            class="w-full pl-10 pr-10 py-3 rounded-lg bg-white text-black focus:outline-none"
                        />
                    </div>
                    <div class="relative">
                        <span
                            class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                        >
                            <Image src={pwd} alt="" />
                        </span>
                        <input
                            type="password"
                            name="passwordConfirm"
                            placeholder="Confirmation mot de passe"
                            required
                            class="w-full pl-10 pr-10 py-3 rounded-lg bg-white text-black focus:outline-none"
                        />
                    </div>
                </div>
                <div class="relative w-48 group">
                    <input
                        type="date"
                        name="date"
                        required
                        class="w-full pl-4 pr-10 py-3 rounded-xl bg-white text-gray-400"
                    />
                </div>
                <div class="flex items-center gap-3 my-4 group cursor-pointer">
                    <div class="relative flex items-center">
                        <input
                            type="checkbox"
                            id="cgu"
                            name="cgu"
                            required
                            class="h-5 w-5 cursor-pointer accent-tonique accent"
                        />
                    </div>

                    <label for="cgu" class="text-xs text-white cursor-pointer">
                        J'accepte les <a href="/cgu" class="text-secondaire"
                            >conditions générales d'utilisation</a
                        >
                    </label>
                </div>

                <button class="action-btn w-full" type="submit">
                    Inscrivez Vous
                </button>
            </form>
        </div>
    </main>

    <script>
        import { createUser, Userauth } from "../../../backend/backend.mjs";

        const form = document.getElementById("registerForm") as HTMLFormElement;

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();

            const formData = new FormData(form);
            const email = formData.get("email") as string;
            const password = formData.get("password") as string;
            const passwordConfirm = formData.get("passwordConfirm") as string;
            const name = formData.get("name") as string;
            const prename = formData.get("prename") as string;
            const pseudo = formData.get("pseudo") as string;
            const date = formData.get("date") as string;

            if (password !== passwordConfirm) {
                return;
            }

            try {
                const user = await createUser(
                    email,
                    password,
                    passwordConfirm,
                    name,
                    prename,
                    pseudo,
                    date,
                );

                if (user) {
                    const auth = await Userauth(email, password);
                    if (auth) {
                        window.location.href = "/";
                    }
                }
            } catch (err) {
                console.error("Détails de l'erreur 400 :", err);
            }
        });
    </script>
</Layout>
