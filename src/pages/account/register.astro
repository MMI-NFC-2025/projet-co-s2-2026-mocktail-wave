---
import Layout from "../../layouts/loginLayout.astro";
import Image from "astro/components/Image.astro";
import logo from "../../assets/icons/logo.svg";
import email from "../../assets/icons/mail.svg";
import pwd from "../../assets/icons/pw.svg";
---

<Layout title="Inscription">
    <main class="w-full max-w-md p-6 mx-auto mt-5">
        <div class="p-8 flex flex-col items-center gap-5">
            <a href="/" class="transition-transform hover:scale-105">
                <Image src={logo} alt="logo image" />
            </a>

            <div class="flex flex-col items-center">
                <h1 class="text-3xl mb-2 font-bold">Inscription</h1>
                <p class="text-sm text-gray-400">
                    Déjà un compte ? <a
                        href="/account/login"
                        class="text-secondaire font-semibold hover:underline"
                        >Connectez vous</a
                    >
                </p>
            </div>

            <form class="w-full mt-8 space-y-5" id="registerForm">
                <div class="space-y-2">
                    <p class="text-sm font-medium text-gray-300">
                        Informations publiques
                    </p>
                    <div class="relative">
                        <span
                            class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                        >
                            <Image src={email} alt="" />
                        </span>
                        <input
                            type="text"
                            name="pseudo"
                            placeholder="pseudo"
                            required
                            class="w-full pl-10 pr-4 py-3 rounded-lg bg-white text-black focus:outline-hidden focus:ring-2 focus:ring-secondaire/50 transition-shadow"
                        />
                    </div>
                </div>

                <div class="space-y-2">
                    <p class="text-sm font-medium text-gray-300">
                        Informations personnelles
                    </p>
                    <div class="relative">
                        <span
                            class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                        >
                            <Image src={email} alt="" />
                        </span>
                        <input
                            type="text"
                            placeholder="prenom"
                            name="prename"
                            required
                            class="w-full pl-10 pr-4 py-3 rounded-lg bg-white text-black focus:outline-hidden focus:ring-2 focus:ring-secondaire/50 transition-shadow"
                        />
                    </div>
                    <div class="relative">
                        <span
                            class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                        >
                            <Image src={email} alt="" />
                        </span>
                        <input
                            type="text"
                            placeholder="nom"
                            name="name"
                            required
                            class="w-full pl-10 pr-4 py-3 rounded-lg bg-white text-black focus:outline-hidden focus:ring-2 focus:ring-secondaire/50 transition-shadow"
                        />
                    </div>
                </div>

                <div class="space-y-2">
                    <p class="text-sm font-medium text-gray-300">
                        Informations de connexion
                    </p>
                    <div class="relative">
                        <span
                            class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                        >
                            <Image src={email} alt="" />
                        </span>
                        <input
                            type="email"
                            name="email"
                            placeholder="adresse@gmail.com"
                            required
                            class="w-full pl-10 pr-4 py-3 rounded-lg bg-white text-black focus:outline-hidden focus:ring-2 focus:ring-secondaire/50 transition-shadow"
                        />
                    </div>

                    <div class="relative">
                        <span
                            class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                        >
                            <Image src={pwd} alt="" />
                        </span>
                        <input
                            type="password"
                            name="password"
                            placeholder="Mot de passe"
                            required
                            class="w-full pl-10 pr-10 py-3 rounded-lg bg-white text-black focus:outline-hidden focus:ring-2 focus:ring-secondaire/50 transition-shadow"
                        />
                    </div>
                    <div class="relative">
                        <span
                            class="absolute inset-y-0 left-3 flex items-center text-gray-400"
                        >
                            <Image src={pwd} alt="" />
                        </span>
                        <input
                            type="password"
                            name="passwordConfirm"
                            placeholder="Confirmation mot de passe"
                            required
                            class="w-full pl-10 pr-10 py-3 rounded-lg bg-white text-black focus:outline-hidden focus:ring-2 focus:ring-secondaire/50 transition-shadow"
                        />
                    </div>
                </div>

                <div class="relative w-full group">
                    <input
                        type="date"
                        name="date"
                        required
                        class="w-full pl-4 pr-4 py-3 rounded-lg bg-white text-gray-500 focus:outline-hidden focus:ring-2 focus:ring-secondaire/50 transition-shadow"
                    />
                </div>

                <div class="flex items-center gap-3 my-4 group cursor-pointer">
                    <input
                        type="checkbox"
                        id="cgu"
                        name="cgu"
                        required
                        class="h-5 w-5 cursor-pointer accent-tonique"
                    />
                    <label
                        for="cgu"
                        class="text-xs text-white cursor-pointer select-none"
                    >
                        J'accepte les <a
                            href="/cgu"
                            class="text-secondaire hover:underline"
                            >conditions générales d'utilisation</a
                        >
                    </label>
                </div>

                <div
                    id="errorMessage"
                    class="hidden bg-red-500/10 border border-red-500/30 text-red-400 text-sm p-3 rounded-xl text-center font-medium"
                >
                </div>

                <button
                    id="submit-btn"
                    class="action-btn w-full flex justify-center items-center py-3 rounded-lg transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                    type="submit"
                >
                    <span id="submit-text">Inscrivez Vous</span>
                </button>
            </form>
        </div>
    </main>

    <script>
        import { createUser, Userauth } from "../../../backend/backend.mjs";

        const form = document.getElementById("registerForm") as HTMLFormElement;
        const errorMsg = document.getElementById("errorMessage");
        const submitBtn = document.getElementById(
            "submit-btn",
        ) as HTMLButtonElement;
        const submitText = document.getElementById("submit-text");

        function displayError(message: string) {
            if (errorMsg) {
                errorMsg.textContent = message;
                errorMsg.classList.remove("hidden");
            }
        }

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();

            // Reset de l'erreur précédente
            errorMsg?.classList.add("hidden");

            const formData = new FormData(form);
            const email = formData.get("email") as string;
            const password = formData.get("password") as string;
            const passwordConfirm = formData.get("passwordConfirm") as string;
            const name = formData.get("name") as string;
            const prename = formData.get("prename") as string;
            const pseudo = formData.get("pseudo") as string;
            const date = formData.get("date") as string;

            // ─── VALIDATIONS UX CÔTÉ CLIENT ──────────────────────────────────
            if (password !== passwordConfirm) {
                displayError("Les deux mots de passe ne correspondent pas.");
                return;
            }

            if (password.length < 8) {
                displayError(
                    "Le mot de passe doit contenir au moins 8 caractères.",
                );
                return;
            }

            if (!/[A-Z]/.test(password)) {
                displayError(
                    "Le mot de passe doit contenir au moins une lettre majuscule.",
                );
                return;
            }

            if (!/[a-z]/.test(password)) {
                displayError(
                    "Le mot de passe doit contenir au moins une lettre minuscule.",
                );
                return;
            }

            // Activation du loader sur le bouton
            if (submitBtn && submitText) {
                submitBtn.disabled = true;
                submitText.textContent = "Création du compte...";
            }

            try {
                const user = await createUser(
                    email,
                    password,
                    passwordConfirm,
                    name,
                    prename,
                    pseudo,
                    date,
                );

                if (user) {
                    if (submitText)
                        submitText.textContent = "Connexion automatique...";

                    const auth = await Userauth(email, password);
                    if (auth) {
                        window.location.href = "/";
                    } else {
                        window.location.href = "/account/login";
                    }
                } else {
                    displayError(
                        "Une erreur est survenue lors de la création du compte.",
                    );
                }
            } catch (err) {
                console.error("Détails de l'erreur :", err);

                if (err instanceof Error) {
                    displayError(err.message);
                } else {
                    displayError(
                        "Une erreur inconnue est survenue. Veuillez réessayer.",
                    );
                }
            } finally {
                // Libération du bouton en cas d'échec
                if (submitBtn && submitText) {
                    submitBtn.disabled = false;
                    submitText.textContent = "Inscrivez Vous";
                }
            }
        });

        form?.querySelectorAll("input").forEach((input) => {
            input.addEventListener("input", () => {
                errorMsg?.classList.add("hidden");
            });
        });
    </script>
</Layout>
