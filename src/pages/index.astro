---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets"; // Utilisation recommandée d'Astro Assets
import hero from "../assets/images/home_hero.avif";
import neoHero from "../assets/images/neo_hero.svg";
import icon from "../assets/icons/icon.svg";
import logo from "../assets/icons/logo.svg";
import palms from "../assets/icons/neo_palms.svg";
import path from "../assets/icons/neo_path.svg";
import social from "../assets/icons/neo_social.svg";
import game from "../assets/icons/neo_game.svg";
import smiley from "../assets/icons/neo_smiley.svg";
import shield from "../assets/icons/neo_shield.svg";
import drink from "../assets/icons/neo_drink.svg";
import party from "../assets/icons/neo_party.svg";
import montbeliard from "../assets/icons/montbeliard.webp";
import doubs from "../assets/icons/doubs.webp";
import secu from "../assets/icons/securite-routiere.webp";
---

<Layout>
	<div class="flex flex-col gap-5 lg:gap-16 mx-auto w-full pb-16">
		<!-- HERO SECTION -->
		<Image
			src={hero}
			alt="Hero Image"
			class="hero lg:hidden w-full object-cover"
		/>

		<div class="flex flex-col relative items-center">
			<div
				class="w-full flex justify-center items-center bg-linear-to-t from-dominante via-tonique/10 to-dominante lg:py-10"
			>
				<Image
					src={icon}
					alt="Icon logo"
					class="w-1/2 lg:w-1/4 max-h-50 lg:max-h-80 object-contain drop-shadow-[0_0_25px_rgba(236,72,153,0.3)]"
				/>
			</div>
			<Image
				src={neoHero}
				alt="Decor Neon"
				class="w-full object-cover -translate-y-5 lg:-translate-y-10 lg:h-[350px]"
			/>
			<div class="flex flex-col items-center mt-5 text-center px-4">
				<h1
					class="text-3xl lg:text-6xl font-bold uppercase tracking-wider text-white neo-title"
				>
					Les cocktails c'est bien
				</h1>
				<p class="text-lg lg:text-3xl text-gray-300 font-medium mt-2">
					les mocktails c'est mieux !
				</p>
			</div>
		</div>

		<div class="flex flex-col items-center">
			<div class="flex justify-center items-center w-full max-w-4xl px-4">
				<Image
					src={palms}
					alt="palmier icons"
					class="h-20 lg:h-36 w-fit object-contain shrink-0"
				/>
				<h2
					class="text-3xl lg:text-5xl neo-title text-center px-4 max-w-lg lg:max-w-2xl"
				>
					Découvrez Mocktail Wave
				</h2>
				<Image
					src={palms}
					alt="palmier icons"
					class="h-20 lg:h-36 w-fit object-contain shrink-0 rotate-y-180"
				/>
			</div>
		</div>

		<div
			class="flex flex-col items-center gap-8 lg:max-w-5xl lg:mx-auto w-full"
		>
			<div class="hidden lg:flex items-center gap-6">
				<Image
					src={logo}
					alt="Logo Shield"
					class="h-40 object-contain"
				/>
			</div>

			<div
				class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-12 px-6 text-center lg:text-left"
			>
				<p class="text-base lg:text-xl leading-relaxed text-center">
					<span class="text-secondaire font-bold">Mocktail Wave</span> est
					une plateforme pensée pour simplifier l’organisation de vos soirées
					dans les bars du Doubs.
				</p>
				<p class="text-base lg:text-xl leading-relaxed text-center">
					<span class="text-secondaire font-bold"
						>Créez un événement</span
					>, invitez vos amis et découvrez les bars de la ville en
					toute simplicité.
				</p>
				<p
					class="col-span-1 lg:col-span-2 text-base lg:text-xl leading-relaxed lg:w-4/5 lg:mx-auto mt-4 text-center"
				>
					<span class="text-secondaire font-bold"
						>Notre esthétique rétro-wave</span
					>, plonge chacune de vos sorties en expériences conviviales,
					fluides et originales.
				</p>
			</div>
		</div>

		<div class="separator"></div>

		<!-- FONCTIONNALITÉS -->
		<div
			class="flex flex-col gap-6 lg:gap-10 px-6 lg:max-w-4xl lg:mx-auto w-full"
		>
			<h2 class="text-3xl lg:text-5xl neo-title text-center lg:mb-4">
				Nos Fonctionnalités
			</h2>

			<div
				class="flex gap-5 lg:gap-8 items-center bg-white/5 lg:bg-transparent p-4 lg:p-0 rounded-xl"
			>
				<Image
					src={path}
					alt="Icon Carte"
					class="w-16 lg:w-24 h-fit shrink-0 object-contain"
				/>
				<p class="text-base lg:text-xl">
					<span class="text-secondaire font-bold"
						>Une carte interactive !</span
					>
					Découvrez les bars de Montbéliard, leurs informations et planifiez
					votre parcours.
				</p>
			</div>

			<div
				class="flex gap-5 lg:gap-8 items-center bg-white/5 lg:bg-transparent p-4 lg:p-0 rounded-xl"
			>
				<Image
					src={social}
					alt="Icon Amis"
					class="w-16 lg:w-24 h-fit shrink-0 object-contain"
				/>
				<p class="text-base lg:text-xl">
					<span class="text-secondaire font-bold"
						>Invitez vos amis</span
					>
					à votre soirée directement sur la plateforme et profitez ensemble
					!
				</p>
			</div>

			<div
				class="flex gap-5 lg:gap-8 items-center bg-white/5 lg:bg-transparent p-4 lg:p-0 rounded-xl"
			>
				<Image
					src={game}
					alt="Icon Jeux"
					class="w-16 lg:w-24 h-fit shrink-0 object-contain"
				/>
				<p class="text-base lg:text-xl">
					<span class="text-secondaire font-bold"
						>Participez à des mini-jeux</span
					>
					amusants dans les bars pour tester vos réflexes entre vous et
					vos amis !
				</p>
			</div>
		</div>

		<div class="separator"></div>

		<!-- VALEURS -->
		<div class="flex flex-col gap-6 lg:gap-12 w-full">
			<div
				class="flex justify-between px-6 lg:px-0 items-center lg:max-w-3xl lg:mx-auto w-full"
			>
				<Image
					src={smiley}
					alt="smiley icon left"
					class="h-12 lg:h-20 w-fit object-contain"
				/>
				<h2 class="text-3xl lg:text-5xl neo-title text-center px-4">
					Nos Valeurs
				</h2>
				<Image
					src={smiley}
					alt="smiley icon right"
					class="h-12 lg:h-20 w-fit object-contain rotate-y-180"
				/>
			</div>

			<div
				class="grid grid-cols-3 gap-4 px-6 lg:max-w-4xl lg:mx-auto w-full lg:gap-16"
			>
				<div class="flex flex-col items-center text-center gap-3">
					<Image
						src={shield}
						alt="Security Icon"
						class="w-16 h-16 lg:w-28 lg:h-28 object-contain"
					/>
					<p class="bebas text-xl lg:text-3xl tracking-wider">
						Sécurité
					</p>
				</div>
				<div class="flex flex-col items-center text-center gap-3">
					<Image
						src={drink}
						alt="Moderate icon"
						class="w-16 h-16 lg:w-28 lg:h-28 object-contain"
					/>
					<p class="bebas text-xl lg:text-3xl tracking-wider">
						Modération
					</p>
				</div>
				<div class="flex flex-col items-center text-center gap-3">
					<Image
						src={party}
						alt="Party icon"
						class="w-16 h-16 lg:w-28 lg:h-28 object-contain"
					/>
					<p class="bebas text-xl lg:text-3xl tracking-wider">
						Ambiance
					</p>
				</div>
			</div>
		</div>

		<div class="separator"></div>

		<!-- REJOINDRE LA COMMUNAUTÉ & SPONSORS -->
		<div class="flex flex-col items-center gap-10 lg:gap-16 w-full">
			<div class="flex flex-col items-center text-center px-4 gap-4">
				<h2 class="text-3xl lg:text-5xl neo-title">
					Rejoins la communautée
				</h2>
				<p class="text-lg lg:text-2xl text-gray-400 font-medium">
					Profite de toutes les fonctionnalitées
				</p>
				<a
					href="/account/register"
					class="page-btn mt-2 font-semibold text-base transition-transform duration-200 hover:scale-105 lg:hidden"
				>
					Inscription / Connexion
				</a>
			</div>

			<div
				class="px-6 py-5 flex flex-col items-center gap-6 w-full lg:max-w-4xl"
			>
				<h2 class="text-3xl lg:text-4xl neo-title text-center">
					Nos Sponsors
				</h2>
				<ul
					class="bg-white flex flex-wrap gap-6 lg:gap-14 justify-center items-center p-6 lg:p-10 rounded-2xl w-full shadow-2xl"
				>
					<li
						class="transition-transform hover:scale-105 duration-200"
					>
						<Image
							src={montbeliard}
							alt="Montbeliard Logo"
							class="h-10 lg:h-16 w-auto object-contain"
						/>
					</li>
					<li
						class="transition-transform hover:scale-105 duration-200"
					>
						<Image
							src={doubs}
							alt="Doubs Logo"
							class="h-10 lg:h-16 w-auto object-contain"
						/>
					</li>
					<li
						class="transition-transform hover:scale-105 duration-200"
					>
						<Image
							src={secu}
							alt="Securite Routiere Logo"
							class="h-12 lg:h-20 w-auto object-contain"
						/>
					</li>
				</ul>
			</div>
		</div>
	</div>
</Layout>
