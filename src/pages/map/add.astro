---
import Layout from "../../layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import hero from "../../assets/images/map_hero.avif";

import { getBars } from "../../../backend/backend.mjs";
const bars = await getBars();
console.log(bars);
---

<Layout title="Carte des Bars">
    <section class="text-white min-h-screen font-sans">
        <Image src={hero} alt="Hero Image" class="hero" />

        <div class="p-5">
            <h1 class="neo-title text-3xl text-center">
                Trouvé les meilleurs bars
            </h1>
            <p class="font-semibold mb-2 text-center">
                Dans toute la région du Doubs
            </p>
        </div>

        <div class="separator"></div>

        <div class="p-6">
            <div
                class="bg-white rounded-2xl overflow-hidden shadow-lg relative h-64"
            >
                <div class="absolute top-2 left-2 right-2 z-[1000]">
                    <input
                        type="text"
                        id="place-autocomplete"
                        placeholder="Rechercher un bar via Google..."
                        class="w-full p-2 rounded-lg text-black text-sm border shadow-sm outline-none"
                        autocomplete="off"
                    />
                    <!-- Formulaire d'ajout de bar -->
                    <div id="add-bar-form-container" class="p-6 hidden">
                        <h2 class="text-2xl mb-2">Ajouter ce bar</h2>
                        <form id="add-bar-form" class="space-y-2">
                            <input
                                type="text"
                                id="bar-name"
                                name="name"
                                placeholder="Nom du bar"
                                class="w-full p-2 rounded"
                                required
                            />
                            <input
                                type="text"
                                id="bar-address"
                                name="address"
                                placeholder="Adresse"
                                class="w-full p-2 rounded"
                                required
                            />
                            <input
                                type="text"
                                id="bar-lat"
                                name="lat"
                                placeholder="Latitude"
                                class="w-full p-2 rounded"
                                required
                            />
                            <input
                                type="text"
                                id="bar-lng"
                                name="lng"
                                placeholder="Longitude"
                                class="w-full p-2 rounded"
                                required
                            />
                            <button type="submit" class="action-btn w-full"
                                >Ajouter à la base</button
                            >
                        </form>
                        <div
                            id="add-bar-success"
                            class="text-green-500 mt-2 hidden"
                        >
                            Bar ajouté !
                        </div>
                        <div
                            id="add-bar-error"
                            class="text-red-500 mt-2 hidden"
                        >
                            Erreur lors de l'ajout.
                        </div>
                    </div>
                </div>
                <div
                    id="map"
                    class="h-full w-full"
                    data-bars={JSON.stringify(bars)}
                >
                </div>
            </div>

            <div class="flex justify-between gap-4 p-4 text-sm font-bold">
                <span class="flex items-center gap-1"
                    ><i class="w-3 h-3 rounded-full bg-tonique"></i> Bar dansant</span
                >
                <span class="flex items-center gap-1"
                    ><i class="w-3 h-3 rounded-full bg-secondaire-dark"></i> Bar chill</span
                >
                <span class="flex items-center gap-1"
                    ><i class="w-3 h-3 rounded-full bg-secondaire"></i> Bar concept</span
                >
            </div>

            <button id="search-btn" class="w-full action-btn font-bold"
                >Rechercher</button
            >
        </div>

        <div class="p-6">
            <h2 class="text-3xl text-center mb-4">Résultats :</h2>
            <div id="results-grid" class="grid grid-cols-2 gap-4"></div>
            <div id="no-results" class="hidden text-center py-10">
                <p class="mb-4">Oups..! Aucun bar trouvé</p>
                <a class="page-btn" href="/">Rajoutez un bar</a>
            </div>
        </div>
    </section>
</Layout>

<style is:global>
    @import "leaflet/dist/leaflet.css";
    .custom-marker {
        border: 2px solid white;
        border-radius: 50%;
    }
</style>

<script>
    const script = document.createElement("script");
    script.src =
        "https://maps.googleapis.com/maps/api/js?key=AIzaSyCjNgOuIut21W6K0y3NABJzdqBfATIuzE4&libraries=places";
    script.async = true;
    script.onload = () => initAutocomplete();
    document.head.appendChild(script);

    let autocomplete;
    function initAutocomplete() {
        const input = document.getElementById("place-autocomplete");
        if (!input) return;
        autocomplete = new window.google.maps.places.Autocomplete(input, {
            types: ["establishment"],
            componentRestrictions: { country: "fr" },
        });
        autocomplete.addListener("place_changed", onPlaceSelected);
    }

    function onPlaceSelected() {
        const place = autocomplete.getPlace();
        if (!place.geometry) return;
        document
            .getElementById("add-bar-form-container")
            .classList.remove("hidden");
        document.getElementById("bar-name").value = place.name || "";
        document.getElementById("bar-address").value =
            place.formatted_address || "";
        document.getElementById("bar-lat").value =
            place.geometry.location.lat();
        document.getElementById("bar-lng").value =
            place.geometry.location.lng();
    }

    document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("add-bar-form");
        if (form) {
            form.onsubmit = async (e) => {
                e.preventDefault();
                const data = {
                    name: form.name.value,
                    address: form.address.value,
                    lat: form.lat.value,
                    lng: form.lng.value,
                };
                try {
                    const res = await fetch("/api/bars", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(data),
                    });
                    if (res.ok) {
                        document
                            .getElementById("add-bar-success")
                            .classList.remove("hidden");
                        document
                            .getElementById("add-bar-error")
                            .classList.add("hidden");
                        form.reset();
                    } else {
                        throw new Error("Erreur API");
                    }
                } catch (err) {
                    document
                        .getElementById("add-bar-success")
                        .classList.add("hidden");
                    document
                        .getElementById("add-bar-error")
                        .classList.remove("hidden");
                }
            };
        }
    });
    import L from "leaflet";

    const mapElement = document.getElementById("map");
    const bars = JSON.parse(mapElement.dataset.bars);

    let map;
    let markers = [];

    function init() {
        map = L.map("map", { zoomControl: false }).setView(
            [47.2378, 6.024],
            13,
        );

        L.tileLayer(
            "https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png",
            {
                attribution: "©OpenStreetMap",
            },
        ).addTo(map);

        renderBars(getBarsInView());

        map.on("moveend zoomend", () => {
            renderBars(getBarsInView());
        });

        document.querySelector("#search-btn").onclick = () => {
            const query = document
                .querySelector("#map-search")
                .value.toLowerCase();
            const filtered = bars.filter((b) =>
                b.name.toLowerCase().includes(query),
            );
            if (filtered.length === 1) {
                map.setView([filtered[0].lat, filtered[0].lng], 16);
            } else if (filtered.length > 1) {
                map.setView([filtered[0].lat, filtered[0].lng], 15);
            }
            renderBars(filtered);
        };
    }

    function getBarsInView() {
        if (!map) return bars;
        const bounds = map.getBounds();
        return bars.filter((bar) => {
            const lat = Number(bar.lat);
            const lng = Number(bar.lng);
            if (isNaN(lat) || isNaN(lng)) return false;
            return bounds.contains([lat, lng]);
        });
    }

    function renderBars(data) {
        const grid = document.querySelector("#results-grid");
        const noResults = document.querySelector("#no-results");
        grid.innerHTML = "";
        markers.forEach((m) => map.removeLayer(m));
        markers = [];

        if (data.length === 0) {
            noResults.classList.remove("hidden");
        } else {
            noResults.classList.add("hidden");
            data.forEach((bar) => {
                const color =
                    bar.themes === "dansant"
                        ? "#ED2EA5"
                        : bar.themes === "chill"
                          ? "#FA8057"
                          : "#fad009";
                const marker = L.circleMarker([bar.lat, bar.lng], {
                    radius: 8,
                    fillColor: color,
                    color: "white",
                    weight: 2,
                    opacity: 1,
                    fillOpacity: 1,
                }).addTo(map);

                marker.bindTooltip(bar.name, {
                    permanent: true,
                    direction: "bottom",
                    className: "bar-label",
                    offset: [0, 10],
                });

                markers.push(marker);
                grid.innerHTML += `
                    <div class="relative rounded-lg overflow-hidden h-40 shadow-md">
                        <img src="${bar.imageUrl}" class="w-full h-full object-cover" />
                        <div class="absolute bottom-0 left-0 right-0 ${color === "#ED2EA5" ? "bg-tonique" : color === "#FA8057" ? "bg-secondaire-dark" : "bg-secondaire"} text-white text-sm font-bold p-2 text-center">
                            ${bar.name} - 5⭐
                        </div>
                    </div>
                `;
            });
        }
    }

    init();
</script>
