---
import Layout from "../../layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import hero from "../../assets/images/map_hero.avif";

import { getBars } from "../../../backend/backend.mjs";
const bars = await getBars();
---

<Layout title="Carte des Bars">
    <section class="text-white min-h-screen font-sans">
        <Image src={hero} alt="Hero Image" class="hero" />

        <div class="p-5">
            <h1 class="neo-title text-3xl text-center">
                Trouvé les meilleurs bars
            </h1>
            <p class="font-semibold mb-2 text-center">
                Dans toute la région du Doubs
            </p>
        </div>

        <div class="separator"></div>

        <div class="p-6">
            <input
                type="text"
                id="search-bar"
                placeholder="Recherche..."
                class="w-full p-2 rounded-lg text-black text-sm border shadow-sm outline-none bg-white"
            />
            <div
                class="bg-white rounded-2xl overflow-hidden shadow-lg relative h-64"
            >
                <div
                    id="map"
                    class="h-full w-full"
                    data-bars={JSON.stringify(bars)}
                >
                </div>
            </div>

            <div class="flex justify-between gap-4 p-4 text-sm font-bold">
                <span class="flex items-center gap-1"
                    ><i class="w-3 h-3 rounded-full bg-tonique"></i> Bar dansant</span
                >
                <span class="flex items-center gap-1"
                    ><i class="w-3 h-3 rounded-full bg-secondaire-dark"></i> Bar chill</span
                >
                <span class="flex items-center gap-1"
                    ><i class="w-3 h-3 rounded-full bg-secondaire"></i> Bar concept</span
                >
            </div>
        </div>

        <div
            id="selection-section"
            class="p-6 hidden flex flex-col items-center"
        >
            <h2 class="text-3xl text-center text-tonique mb-2">
                Ma Sélection :
            </h2>
            <div id="selection-grid" class="grid grid-cols-2 gap-4"></div>
            <button id="create-party-btn" class="action-btn mt-4 font-bold"
                >Créer une soirée</button
            >
            <div class="separator mt-8"></div>
        </div>

        <div class="p-6">
            <h2 class="text-3xl text-center mb-4">Résultats :</h2>
            <div id="results-grid" class="grid grid-cols-2 gap-4"></div>
            <div
                id="pagination-container"
                class="flex w-full justify-center gap-2 mt-5"
            >
            </div>
            <div id="no-results" class="hidden text-center py-10">
                <p class="mb-4">Oups..! Aucun bar trouvé</p>
                <a class="page-btn" href="/map/add">Rajoutez un bar</a>
            </div>
        </div>
    </section>
</Layout>

<style is:global>
    @import "leaflet/dist/leaflet.css";
    .custom-marker {
        border: 2px solid white;
        border-radius: 50%;
    }
</style>
<script>
    import L from "leaflet";
    import { isLogged, updateUserInfo } from "../../../backend/backend.mjs";

    const mapElement = document.getElementById("map");
    const bars = JSON.parse(mapElement.dataset.bars);

    let map;
    let markers = [];
    let selected = [];
    let currentPage = 1;
    const itemsPerPage = 6;

    async function init() {
        const user = await isLogged();
        if (!user) {
            window.location.href = "/account/login";
            return;
        }
        map = L.map("map", { zoomControl: false }).setView(
            [47.2378, 6.024],
            13,
        );

        L.tileLayer(
            "https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png",
            {
                attribution: "©OpenStreetMap",
            },
        ).addTo(map);

        map.on("moveend zoomend", () => {
            renderBars(getBarsInView());
        });

        document.querySelector("#search-bar")?.addEventListener("input", () => {
            const query = document
                .querySelector("#search-bar")
                .value.toLowerCase();
            const filtered = bars.filter((b) =>
                b.name.toLowerCase().includes(query),
            );
            renderBars(filtered);
        });

        document.addEventListener("click", (e) => {
            const btn = e.target.closest(".bar_card");
            if (btn) {
                const id = btn.dataset.id;
                toggleSelection(id);
            }
        });

        renderBars(getBarsInView());
    }

    function toggleSelection(id) {
        if (selected.includes(id)) {
            selected = selected.filter((item) => item !== id);
        } else {
            if (selected.length >= 10) {
                alert("Vous ne pouvez sélectionner que 10 bars maximum.");
                return;
            }
            selected.push(id);
        }
        renderBars(getBarsInView());
    }
    function getBarsInView() {
        if (!map) return bars;
        const bounds = map.getBounds();
        return bars.filter((bar) => {
            const lat = Number(bar.lat);
            const lng = Number(bar.lng);
            if (isNaN(lat) || isNaN(lng)) return false;
            return bounds.contains([lat, lng]);
        });
    }
    function renderBars(data) {
        const grid = document.querySelector("#results-grid");
        const selectionGrid = document.querySelector("#selection-grid");
        const selectionSection = document.querySelector("#selection-section");
        const noResults = document.querySelector("#no-results");
        const pagination = document.querySelector("#pagination-container");

        grid.innerHTML = "";
        selectionGrid.innerHTML = "";
        markers.forEach((m) => map.removeLayer(m));
        markers = [];

        if (selected.length > 0) {
            selectionSection.classList.remove("hidden");
            const selectedBars = bars.filter((b) => selected.includes(b.id));

            let selectionHTML = "";
            selectedBars.forEach((bar) => {
                selectionHTML += generateBarHTML(bar, true);
            });
            selectionGrid.innerHTML = selectionHTML;
        } else {
            selectionSection.classList.add("hidden");
        }

        const resultsToDisplay = data.filter(
            (bar) => !selected.includes(bar.id),
        );
        const totalPages = Math.ceil(resultsToDisplay.length / itemsPerPage);
        if (currentPage > totalPages) currentPage = 1;
        const start = (currentPage - 1) * itemsPerPage;
        const paginated = resultsToDisplay.slice(start, start + itemsPerPage);

        if (paginated.length === 0 && selected.length === 0) {
            noResults.classList.remove("hidden");
        } else {
            noResults.classList.add("hidden");
            let resultsHTML = "";
            paginated.forEach((bar) => {
                const marker = createMarker(bar);
                markers.push(marker);
                resultsHTML += generateBarHTML(bar, false);
            });
            grid.innerHTML = resultsHTML;
        }
        renderPagination(pagination, resultsToDisplay.length, itemsPerPage);
    }

    function renderPagination(container, totalItems, itemsPerPage) {
        const totalPages = Math.ceil(totalItems / itemsPerPage);
        container.innerHTML =
            totalPages > 1 ? `<p class="opacity-50">Pages</p>` : "";
        for (let i = 1; i <= totalPages; i++) {
            const btn = document.createElement("button");
            btn.textContent = i;
            btn.className = `px-2 ${i === currentPage ? "text-tonique font-bold" : "text-white"}`;
            btn.onclick = () => {
                currentPage = i;
                renderBars(getBarsInView());
            };
            container.appendChild(btn);
        }
    }

    function generateBarHTML(bar, isSelected) {
        const color =
            bar.themes === "dansant"
                ? "#ED2EA5"
                : bar.themes === "chill"
                  ? "#FA8057"
                  : "#fad009";
        const bgColorClass =
            bar.themes === "dansant"
                ? "bg-tonique"
                : bar.themes === "chill"
                  ? "bg-secondaire-dark"
                  : "bg-secondaire";

        const ring = isSelected ? "ring-4 ring-tonique shadow-2xl" : "";

        return `
            <button class="relative rounded-lg overflow-hidden h-40 shadow-md bar_card ${ring} transition-all" data-id='${bar.id}'>
                <img src="${bar.imageUrl}" class="w-full h-full object-cover" />
                <div class="absolute bottom-0 left-0 right-0 ${bgColorClass} text-white text-sm font-bold p-2 text-center">
                    ${bar.name}
                </div>
            </button>
        `;
    }

    function createMarker(bar) {
        const color =
            bar.themes === "dansant"
                ? "#ED2EA5"
                : bar.themes === "chill"
                  ? "#FA8057"
                  : "#fad009";
        const marker = L.circleMarker([bar.lat, bar.lng], {
            radius: 8,
            fillColor: color,
            color: "white",
            weight: 2,
            opacity: 1,
            fillOpacity: 1,
        }).addTo(map);

        marker.bindTooltip(bar.name, {
            permanent: true,
            direction: "bottom",
            className: "bar-label",
            offset: [0, 10],
        });
        return marker;
    }

    async function createParty() {
        const user = await isLogged();
        const userID = user.id;
        if (selected.length === 0) {
            alert(
                "Veuillez sélectionner au moins un bar pour créer une soirée.",
            );
            return;
        }
        try {
            const response = await fetch("/api/addEvent", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({ bars: selected, leader: userID }),
            });
            if (!response.ok)
                throw new Error("Erreur lors de la création de la soirée");
            const data = await response.json();
            await updateUserInfo(data.userData);
            window.location.href = `/soiree/${data.event.id}`;
        } catch (err) {
            alert("Erreur lors de la création de la soirée");
        }
    }
    document.addEventListener("DOMContentLoaded", () => {
        const partyBtn = document.getElementById("create-party-btn");
        if (partyBtn) {
            partyBtn.addEventListener("click", createParty);
        }
    });

    init();
</script>
