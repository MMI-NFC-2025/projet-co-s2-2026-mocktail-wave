---
import Layout from "../../layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import hero from "../../assets/images/social_hero.avif";
import editicon from "../../assets/icons/neo_edit.svg";

import { getUser, isLogged } from "../../../backend/backend.mjs";

const { id } = Astro.params;

const user = await getUser(id);
const logged = await isLogged();
console.log(logged);
---

<Layout>
    <div class="flex flex-col gap-5">
        <Image src={hero} alt="Hero Image" class="hero" />
        <div class="p-5">
            <h1 class="neo-title text-3xl text-center">{user.tag}</h1>
            <p class="">
                <a
                    href=""
                    class="flex items-center gap-2 font-semibold mb-5 text-tonique justify-center"
                    >{user.prename} {user.name}</a
                >
            </p>
            <div class="separator"></div>
        </div>
        <div class="p-5">
            <h2 class="neo-title text-3xl text-center">Participe à</h2>
        </div>
    </div>
</Layout>
