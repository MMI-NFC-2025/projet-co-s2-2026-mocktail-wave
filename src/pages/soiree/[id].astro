---
import Image from "astro/components/Image.astro";
import hero from "../../assets/images/event_hero.avif";
import Layout from "../../layouts/Layout.astro";
import editIcon from "../../assets/icons/edit.svg";

const { id } = Astro.params;
---

<Layout>
    <div
        id="event-page-container"
        data-id={id}
        class="flex flex-col gap-6 pb-12"
    >
        <div class="relative w-full overflow-hidden max-h-56 shadow-lg">
            <Image
                src={hero}
                alt="Hero Image"
                class="w-full h-full object-cover opacity-80"
            />
        </div>

        <div class="px-5 text-center max-w-md mx-auto w-full">
            <div class="flex items-center justify-center gap-3 w-full mt-7">
                <h1
                    id="event-title"
                    class="neo-title text-3xl font-extrabold tracking-wide text-white uppercase truncate max-w-[80%]"
                >
                    Analyse en cours...
                </h1>

                <input
                    type="text"
                    id="edit-title-input"
                    class="hidden text-2xl font-bold tracking-wide bg-dominante border-b-2 border-tonique text-white text-center focus:outline-none rounded w-full px-2 py-1"
                />

                <button
                    id="edit-title-btn"
                    class="text-white hover:text-tonique transition hidden shrink-0"
                >
                    <Image
                        src={editIcon}
                        alt="Modifier"
                        id="icon-pencil"
                        class="w-5 h-5"
                    />
                </button>

                <button
                    id="icon-check"
                    class="bg-green-400 px-3 py-1.5 rounded-xl font-bold hidden text-black text-sm shrink-0 hover:bg-green-300 transition"
                >
                    Confirmer
                </button>
            </div>

            <div class="flex justify-center gap-4 mt-4">
                <span
                    id="badge-leader"
                    class="hidden w-10 h-10 transition-transform hover:scale-105"
                    title="Créateur de la soirée"
                >
                    <img
                        src="/leader.svg"
                        alt="leader icon"
                        class="w-full h-full"
                    />
                </span>
                <span
                    id="badge-sam"
                    class="hidden w-10 h-10 transition-transform hover:scale-105"
                    title="SAM (Capitaine de soirée)"
                >
                    <img src="/sam.svg" alt="sam icon" class="w-full h-full" />
                </span>
            </div>

            <div class="mt-6 flex flex-col gap-4 items-center p-4 rounded-2xl">
                <div
                    id="countdown-container"
                    class="font-semibold flex items-center justify-center gap-2 text-base text-gray-200 gradient"
                >
                    <span id="countdown-label">Début dans :</span>
                    <span id="countdown" class="text-white font-bold"
                        >XX:XX:XX</span
                    >

                    <button
                        id="edit-date-btn"
                        class="hidden text-white hover:text-tonique transition ml-1 shrink-0"
                    >
                        <Image
                            src={editIcon}
                            alt="Modifier la date"
                            class="w-4 h-4"
                        />
                    </button>
                </div>

                <div
                    id="date-picker-container"
                    class="hidden flex items-center gap-2 w-full max-w-xs mx-auto"
                >
                    <input
                        type="datetime-local"
                        id="edit-date-input"
                        class="bg-dominante w-full border-2 border-tonique text-white px-3 py-2 rounded-xl font-semibold text-sm focus:outline-none"
                    />
                    <button
                        id="confirm-date-btn"
                        class="bg-green-400 text-black px-4 py-2 rounded-xl font-bold text-sm hover:bg-green-300 transition shrink-0"
                    >
                        Ok
                    </button>
                </div>

                <button
                    id="start-event-btn"
                    class="action-btn font-bold shadow-md text-sm uppercase"
                >
                    Que la soirée commence !
                </button>
            </div>

            <div class="separator mt-6"></div>
        </div>

        <div id="map-section" class="px-5 max-w-md mx-auto w-full hidden">
            <div
                class="bg-gray-900 rounded-2xl overflow-hidden shadow-2xl relative h-72 w-full border border-white/10 mt-5"
            >
                <div id="map" class="h-full w-full hidden"></div>
            </div>

            <div
                id="map-legend"
                class="hidden flex justify-between px-2 mt-3 font-bold text-gray-300 py-2 rounded-xl"
            >
                <div class="flex items-center gap-1.5">
                    <span
                        class="w-2.5 h-2.5 rounded-full bg-tonique inline-block"
                    ></span>
                    <span>Dansante</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span
                        class="w-2.5 h-2.5 rounded-full bg-secondaire-dark inline-block"
                    ></span>
                    <span>Chill</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span
                        class="w-2.5 h-2.5 rounded-full bg-secondaire inline-block"
                    ></span>
                    <span>Concept</span>
                </div>
            </div>
        </div>

        <div
            id="bars-container"
            class="px-5 mt-5 max-w-md mx-auto w-full flex flex-col gap-4"
        >
        </div>

        <div class="separator mt-6"></div>

        <div id="challenge-section" class="hidden">
            <div
                id="challenge-box"
                class="hidden px-4 rounded-2xl text-white max-w-md mx-auto"
            >
            </div>

            <div id="challenge-chrono" class="gradient font-semibold mx-auto">
            </div>

            <div class="separator mt-10"></div>
        </div>

        <div class="p-5 max-w-md mx-auto w-full mt-4">
            <h2
                class="neo-title text-2xl font-bold mb-4 uppercase tracking-wider text-gray-200"
            >
                Participants
            </h2>

            <ul id="participants-list" class="flex flex-col gap-3 mb-6"></ul>

            <div class="relative w-full">
                <div class="relative w-full">
                    <input
                        type="text"
                        id="search-friends-input"
                        placeholder="Rechercher un ami à inviter..."
                        class="w-full bg-white text-gray-900 px-4 py-3 pr-12 rounded-xl font-medium placeholder-gray-400 focus:outline-none shadow-md text-sm"
                        autocomplete="off"
                    />
                    <div
                        class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"
                    >
                        <span
                            id="accordion-arrow"
                            class="transition-transform duration-300 text-gray-400 inline-block text-[10px]"
                        >
                            ▼
                        </span>
                    </div>
                </div>

                <div
                    id="friends-accordion-content"
                    class="hidden absolute z-30 left-0 right-0 max-h-60 overflow-y-auto mt-2 bg-dominante border border-tonique rounded-2xl p-3 shadow-2xl flex flex-col gap-2"
                >
                    <ul id="friends-list" class="flex flex-col gap-2"></ul>
                </div>
            </div>
        </div>
    </div>

    <div
        id="custom-confirm-modal"
        class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm transition-all duration-200"
    >
        <div
            class="bg-dominante border border-tonique p-6 rounded-3xl max-w-sm w-full text-center shadow-2xl transform scale-95 transition-transform duration-200"
        >
            <h3 id="modal-title" class="text-white text-xl font-bold mb-2">
                Confirmation
            </h3>
            <p
                id="modal-message"
                class="text-gray-300 text-sm mb-6 leading-relaxed"
            >
                Êtes-vous sûr de vouloir effectuer cette action ?
            </p>
            <div class="flex gap-4 justify-center">
                <button
                    id="modal-cancel-btn"
                    class="px-5 py-2.5 text-white rounded-xl font-semibold transition text-sm"
                >
                    Annuler
                </button>
                <button
                    id="modal-confirm-btn"
                    class="px-5 py-2.5 bg-red-500 hover:bg-red-400 text-white rounded-xl font-bold transition text-sm"
                >
                    Confirmer
                </button>
            </div>
        </div>
    </div>
</Layout>

<script>
    import {
        getEvent,
        isLogged,
        updateEventTitle,
        updateEventDate,
        setEventDateToNow,
        addParticipantToEvent,
        getFriendList,
        updateEventLeader,
        updateEventSam,
        removeParticipantFromEvent,
        updateClassement,
        startEvent,
        loadMyChallenge,
        validateChallenge,
        getClassement,
    } from "../../../backend/backend.mjs";

    // Variables globales
    let countdownInterval: number | undefined;
    let challengeInterval: number | null = null;
    let map: any = null;
    let routingControl: any = null;
    let geoWatchId: number | null = null;
    let barLatLon: [number, number] | null = null;
    let currentUserPos: [number, number] | null = null;
    let eventStatus = "pending";
    let currentChallenge = null;
    const container = document.getElementById("event-page-container");
    const id = container.getAttribute("data-id");

    function startChallengeWatcher(eventId) {
        const chronoEl = document.getElementById("challenge-chrono");
        if (!chronoEl) return;

        if (challengeInterval) clearInterval(challengeInterval);
        async function update() {
            const user = await isLogged();
            if (!user) return;

            const res = await getClassement(id);

            const classement = res;
            const me = classement.users?.[user.id];

            if (me?.current_challenge) {
                chronoEl.classList.add("hidden");
                return;
            }

            chronoEl.classList.remove("hidden");

            const last = me?.last_challenge
                ? new Date(me.last_challenge).getTime()
                : 0;

            const cooldown = 2 * 60 * 60 * 1000;
            const target = last + cooldown;

            const now = Date.now();
            let diff = target - now;

            if (diff <= 0) {
                chronoEl.textContent = "Nouveau défi en cours...";

                await updateClassement(eventId);

                const newChallenge = await loadMyChallenge(eventId, user);

                if (newChallenge) {
                    showChallengeUI(newChallenge);
                }

                return;
            }

            const hours = Math.floor(diff / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);

            chronoEl.textContent = `Prochain défi dans : ${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
        }

        update();
        challengeInterval = setInterval(update, 1000) as unknown as number;
    }

    // Compte à rebours
    function startCountdown(eventDateString: string) {
        const countdownEl = document.getElementById("countdown");
        const countdownLabel = document.getElementById("countdown-label");
        if (!countdownEl || !countdownLabel) return;

        if (countdownInterval) clearInterval(countdownInterval);

        countdownLabel.textContent = "Début dans :";
        const targetDate = new Date(eventDateString).getTime();

        function updateClock() {
            const now = new Date().getTime();
            const distance = targetDate - now;

            if (distance <= 0) {
                countdownEl.textContent = "C'est parti ! 🎉";
                if (countdownInterval) clearInterval(countdownInterval);
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor(
                (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
            );
            const minutes = Math.floor(
                (distance % (1000 * 60 * 60)) / (1000 * 60),
            );
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            const pad = (num: number) => String(num).padStart(2, "0");

            if (days > 0) {
                countdownEl.textContent = `${days}j ${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
            } else {
                countdownEl.textContent = `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
            }
        }

        updateClock();
        countdownInterval = setInterval(updateClock, 1000) as unknown as number;
    }

    async function displayGPS(address, bar) {
        const mapContainer = document.getElementById("map");
        const legendContainer = document.getElementById("map-legend");
        if (!mapContainer) return;

        try {
            // 1. Géocodage de l'adresse du bar via Nominatim
            const response = await fetch(
                `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}`,
            );
            const data = await response.json();

            if (data && data.length > 0) {
                const barLat = parseFloat(data[0].lat);
                const barLon = parseFloat(data[0].lon);
                let currentColorClass = "#FAD009";

                // Rendre visible la carte et la légende
                mapContainer.classList.remove("hidden");
                if (data.length > 1) {
                    legendContainer?.classList.remove("hidden");
                }

                // 2. Chargement dynamique des CSS
                if (!document.querySelector('link[href*="leaflet.css"]')) {
                    const link = document.createElement("link");
                    link.rel = "stylesheet";
                    link.href =
                        "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
                    document.head.appendChild(link);
                }
                if (
                    !document.querySelector(
                        'link[href*="leaflet-routing-machine"]',
                    )
                ) {
                    const linkRouting = document.createElement("link");
                    linkRouting.rel = "stylesheet";
                    linkRouting.href =
                        "https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css";
                    document.head.appendChild(linkRouting);
                }

                // 3. Chargement dynamique des Scripts JS
                if (!(window as any).L) {
                    await new Promise((resolve) => {
                        const script = document.createElement("script");
                        script.src =
                            "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
                        script.onload = resolve;
                        document.head.appendChild(script);
                    });
                }
                if (!(window as any).L.Routing) {
                    await new Promise((resolve) => {
                        const scriptRouting = document.createElement("script");
                        scriptRouting.src =
                            "https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js";
                        scriptRouting.onload = resolve;
                        document.head.appendChild(scriptRouting);
                    });
                }

                const L = (window as any).L;

                // 4. Initialisation de la carte (On commence centré sur le bar par défaut)
                if (!map) {
                    map = L.map("map", {
                        zoomControl: false, // On désactive les boutons +/- pour une UI plus épurée comme sur une app native
                    }).setView([barLat, barLon], 16);

                    L.tileLayer(
                        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                        {
                            attribution: "© OpenStreetMap",
                        },
                    ).addTo(map);
                }

                // Icônes personnalisées épurées (Fini les gros marqueurs bleus cassés de Leaflet)
                const userIcon = L.divIcon({
                    html: `<div class="w-4 h-4 bg-blue-500 border-2 border-white rounded-full shadow-md animate-pulse"></div>`,
                    className: "custom-user-icon",
                    iconSize: [16, 16],
                    iconAnchor: [8, 8],
                });

                const barIcon = L.divIcon({
                    html: `<svg class='fill-tonique drop-shadow-lg drop-shadow-black' alt='map repere'><path d="M25.206 12.603C25.206 5.643 19.563 0 12.603 0S0 5.642 0 12.603c0 2.757.888 5.305 2.39 7.38h-.004L12.603 34 22.82 19.983h-.003a12.544 12.544 0 002.389-7.38zM12.603 17.68a5.078 5.078 0 110-10.156 5.078 5.078 0 010 10.156z" /></svg>`,
                    className: "custom-bar-icon",
                    iconSize: [32, 32],
                    iconAnchor: [16, 32],
                });

                let isFirstLoad = true;

                // 5. Tracking en TEMPS RÉEL (watchPosition) pour l'expérience GPS
                if (navigator.geolocation) {
                    if (geoWatchId)
                        navigator.geolocation.clearWatch(geoWatchId);

                    geoWatchId = navigator.geolocation.watchPosition(
                        (position) => {
                            const userLat = position.coords.latitude;
                            const userLon = position.coords.longitude;
                            currentUserPos = [userLat, userLon];

                            if (routingControl) {
                                routingControl.setWaypoints([
                                    L.latLng(userLat, userLon),
                                    L.latLng(barLat, barLon),
                                ]);
                            } else {
                                routingControl = L.Routing.control({
                                    waypoints: [
                                        L.latLng(userLat, userLon),
                                        L.latLng(barLat, barLon),
                                    ],
                                    routeWhileDragging: false,
                                    addWaypoints: false,
                                    fitSelectedRoutes: false,
                                    show: false,
                                    collapsible: false,
                                    lineOptions: {
                                        styles: [
                                            {
                                                color: "#ED2EA5",
                                                weight: 6,
                                                opacity: 1,
                                            },
                                        ],
                                    },
                                    createMarker: function (
                                        i: number,
                                        waypoint: any,
                                    ) {
                                        if (i === 0) {
                                            return L.marker(waypoint.latLng, {
                                                icon: userIcon,
                                            }).bindPopup("Tu es ici 📍");
                                        } else {
                                            return L.marker(waypoint.latLng, {
                                                icon: barIcon,
                                            })
                                                .bindPopup(`<b>${bar.name}</b>`)
                                                .openPopup();
                                        }
                                    },
                                }).addTo(map);
                            }

                            if (isFirstLoad) {
                                map.setView([userLat, userLon], 16);
                                isFirstLoad = false;
                            }
                        },
                        (error) => {
                            console.warn(
                                "Tracking GPS indisponible. Affichage du bar uniquement.",
                            );
                            L.marker([barLat, barLon], { icon: barIcon })
                                .addTo(map)
                                .bindPopup(`<b>${bar.name}</b><br>${address}`)
                                .openPopup();
                        },
                        {
                            enableHighAccuracy: true,
                            timeout: 10000,
                            maximumAge: 0,
                        },
                    );
                } else {
                    L.marker([barLat, barLon], { icon: barIcon })
                        .addTo(map)
                        .bindPopup(`<b>${bar.name}</b>`)
                        .openPopup();
                }

                setTimeout(() => {
                    map.invalidateSize();
                }, 250);
            }
        } catch (error) {
            console.error("Erreur lors du calcul GPS :", error);
        }
    }

    function setDestination(barLat: number, barLon: number) {
        const L = (window as any).L;
        if (!map || !currentUserPos) return;

        barLatLon = [barLat, barLon];

        if (routingControl) {
            routingControl.setWaypoints([
                L.latLng(currentUserPos[0], currentUserPos[1]),
                L.latLng(barLat, barLatLon[1]),
            ]);
        }
    }

    async function geocode(address: string) {
        const res = await fetch(
            `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}`,
        );
        const data = await res.json();
        if (!data?.length) return null;

        return {
            lat: parseFloat(data[0].lat),
            lon: parseFloat(data[0].lon),
        };
    }

    function showChallengeUI() {
        const box = document.getElementById("challenge-box");

        if (!box || !currentChallenge) return;

        box.classList.remove("hidden");

        box.innerHTML = `
        <div class="flex flex-col gap-2 px-5 pt-5">
            <h2 class="text-3xl font-bold neo-title">Ton Défi</h2>
            <h3 class="text-2xl font-bold">${currentChallenge.name}</h3>
            <span class="text-xl">${currentChallenge.categories}</span>
            <p>${currentChallenge.rule}</p>

            <button
                id="validate-challenge-btn"
                class="mt-4 action-btn mx-auto font-bold py-2 px-4 rounded-xl transition"
            >
                Valider le défi
            </button>
        </div>
    `;

        const validateBtn = document.getElementById("validate-challenge-btn");

        validateBtn?.addEventListener("click", async () => {
            try {
                validateBtn.setAttribute("disabled", "true");
                validateBtn.textContent = "Validation...";

                await validateChallenge(id);
                window.location.reload();
            } catch (err) {
                console.error(err);
                validateBtn.removeAttribute("disabled");
                validateBtn.textContent = "Valider le défi";
            }
        });
    }

    // Initialisation
    async function init() {
        const currentUser = await isLogged();
        if (!currentUser) {
            window.location.href = "/account/login";
            return;
        }
        if (!container) return;
        if (!id) return;

        try {
            await updateClassement(id);

            currentChallenge = await loadMyChallenge(id, currentUser);
            showChallengeUI();
        } catch (err) {
            console.error("Erreur challenge mode :", err);
        }

        try {
            const soiree = await getEvent(id);
            const now = Date.now();
            const eventTime = new Date(soiree.date).getTime();
            if (
                (soiree.status === "pending" || !soiree.status) &&
                eventTime <= now
            ) {
                await startEvent(soiree.id);
            }

            const titleHeading = document.getElementById("event-title");
            const editInput = document.getElementById(
                "edit-title-input",
            ) as HTMLInputElement;
            const editBtn = document.getElementById("edit-title-btn");
            const iconCheck = document.getElementById("icon-check");

            const countdownEl = document.getElementById("countdown");
            const countdownLabel = document.getElementById("countdown-label");
            const countdownContainer = document.getElementById(
                "countdown-container",
            );
            const editDateBtn = document.getElementById("edit-date-btn");
            const datePickerContainer = document.getElementById(
                "date-picker-container",
            );
            const editDateInput = document.getElementById(
                "edit-date-input",
            ) as HTMLInputElement;
            const confirmDateBtn = document.getElementById("confirm-date-btn");

            const startEventBtn = document.getElementById("start-event-btn");

            const isLeader = soiree.leader === currentUser.id;
            const isSam = soiree.sam === currentUser.id;

            if (titleHeading) {
                titleHeading.textContent =
                    soiree.title || soiree.name || "Nom de la soirée";
            }

            if (isLeader) {
                editBtn?.classList.remove("hidden");

                document
                    .getElementById("badge-leader")
                    ?.classList.remove("hidden");
            }

            if (isSam) {
                document
                    .getElementById("badge-sam")
                    ?.classList.remove("hidden");
            }

            // Date de la soirée
            let initialDate = soiree.date || soiree.event_date;

            const isStarted = initialDate
                ? new Date(initialDate).getTime() <= now
                : false;
            if (isStarted) {
                const chalSection =
                    document.getElementById("challenge-section");
                const mapSection = document.getElementById("map-section");
                chalSection?.classList.remove("hidden");
                mapSection?.classList.remove("hidden");
            }
            if (isLeader && startEventBtn) {
                startEventBtn.classList.remove("hidden");

                if (isStarted) {
                    await updateClassement(id);
                    startEventBtn.textContent = "Fin de soirée !";

                    countdownEl?.classList.add("hidden");
                    countdownContainer?.classList.add("hidden");

                    startEventBtn.addEventListener("click", async () => {
                        const confirmed = await askConfirmation(
                            "Fin de soirée",
                            "Voulez-vous vraiment terminer cette soirée ?",
                            true,
                        );

                        if (!confirmed) return;

                        try {
                            startEventBtn.setAttribute("disabled", "true");

                            await endEvent(id);

                            window.location.href = "/events";
                        } catch (err) {
                            console.error(err);
                            alert("Impossible de terminer la soirée.");
                            startEventBtn.removeAttribute("disabled");
                        }
                    });
                } else {
                    startEventBtn.textContent = "Que la soirée commence !";

                    startEventBtn.addEventListener("click", async () => {
                        try {
                            startEventBtn.setAttribute("disabled", "true");

                            await setEventDateToNow(id);
                            await updateClassement(id);
                            window.location.reload();
                        } catch (err) {
                            console.error(err);
                            alert(
                                "Impossible de lancer la soirée immédiatement.",
                            );
                            startEventBtn.removeAttribute("disabled");
                        }
                    });
                }
            }

            if (initialDate) {
                startCountdown(initialDate);
                if (isLeader) editDateBtn?.classList.remove("hidden");
            } else {
                if (countdownEl && countdownLabel) {
                    countdownLabel.textContent = "";
                    if (isLeader) {
                        countdownEl.textContent =
                            "Définir la date de la soirée";
                        countdownEl.classList.add("cursor-pointer");
                    } else {
                        countdownEl.textContent = "Date à définir";
                    }
                }
            }

            if (
                isLeader &&
                countdownEl &&
                datePickerContainer &&
                editDateInput &&
                confirmDateBtn
            ) {
                const openDateEditor = () => {
                    if (initialDate) {
                        const d = new Date(initialDate);
                        const tzoffset = d.getTimezoneOffset() * 60000;
                        const localISOTime = new Date(d.getTime() - tzoffset)
                            .toISOString()
                            .slice(0, 16);
                        editDateInput.value = localISOTime;
                    }

                    countdownEl.classList.add("hidden");
                    if (countdownLabel) countdownLabel.classList.add("hidden");
                    editDateBtn?.classList.add("hidden");
                    datePickerContainer.classList.remove("hidden");
                };

                countdownEl.addEventListener("click", () => {
                    if (!initialDate) openDateEditor();
                });
                editDateBtn?.addEventListener("click", openDateEditor);

                confirmDateBtn.addEventListener("click", async () => {
                    const newDateValue = editDateInput.value;
                    if (!newDateValue) return;

                    try {
                        confirmDateBtn.setAttribute("disabled", "true");
                        const isoDate = new Date(newDateValue).toISOString();

                        await updateEventDate(id, isoDate);
                        initialDate = isoDate;

                        datePickerContainer.classList.add("hidden");
                        countdownEl.classList.remove("hidden");
                        if (countdownLabel)
                            countdownLabel.classList.remove("hidden");
                        editDateBtn?.classList.remove("hidden");
                        countdownEl.classList.remove("cursor-pointer");

                        startCountdown(isoDate);
                    } catch (err) {
                        console.error(err);
                        alert("Erreur lors de la modification de la date.");
                    } finally {
                        confirmDateBtn.removeAttribute("disabled");
                    }
                });
            }

            let isEditing = false;

            async function saveTitle() {
                if (!titleHeading || !editInput || !editBtn || !iconCheck)
                    return;

                const currentTitle = titleHeading.textContent?.trim() || "";
                const newTitle = editInput.value.trim();

                if (newTitle && newTitle !== currentTitle) {
                    try {
                        editBtn.setAttribute("disabled", "true");
                        iconCheck.setAttribute("disabled", "true");
                        titleHeading.textContent = "...";

                        await updateEventTitle(id, newTitle);
                        titleHeading.textContent = newTitle;
                    } catch (err) {
                        console.error(err);
                        alert("Erreur lors du changement de nom.");
                        titleHeading.textContent = currentTitle;
                    } finally {
                        editBtn.removeAttribute("disabled");
                        iconCheck.removeAttribute("disabled");
                    }
                }

                editInput.classList.add("hidden");
                titleHeading.classList.remove("hidden");
                iconCheck.classList.add("hidden");
                editBtn.classList.remove("hidden");
                isEditing = false;
            }

            if (editBtn && titleHeading && editInput && iconCheck) {
                editBtn.addEventListener("click", () => {
                    isEditing = true;
                    editInput.value = titleHeading.textContent?.trim() || "";

                    titleHeading.classList.add("hidden");
                    editBtn.classList.add("hidden");
                    editInput.classList.remove("hidden");
                    iconCheck.classList.remove("hidden");
                    editInput.focus();
                });

                iconCheck.addEventListener("click", async () => {
                    await saveTitle();
                });

                editInput.addEventListener("keydown", async (e) => {
                    if (e.key === "Enter") {
                        await saveTitle();
                    }
                });
            }

            // Gestion des bars
            const barsContainer = document.getElementById("bars-container");
            const bars = soiree.expand?.bars || [];
            const barsWithCoords = await Promise.all(
                bars.map(async (bar) => {
                    const coords = await geocode(bar.address);
                    return { ...bar, coords };
                }),
            );

            if (barsContainer && bars.length > 0) {
                if (bars.length === 1) {
                    const bar = bars[0];
                    barsContainer.innerHTML = `
                        <div class="relative w-full rounded-3xl overflow-hidden shadow-2xl aspect-square max-w-sm mx-auto bg-gray-900">
                            <img src="${bar.imageUrl || "/images/default-bar.jpg"}" alt="${bar.name}" class="w-full h-full object-cover"/>
                            <div class="absolute bottom-0 left-0 right-0 bg-[#E2B714]/80 backdrop-blur-md p-4 rounded-2xl text-white shadow-lg">
                                <h3 class="text-3xl font-bold uppercase tracking-wide truncate">${bar.name || "Nom du bar"}</h3>
                                <p class="text-sm font-medium mt-1 opacity-90 truncate">Adresse : ${bar.address || "XX rue du XXXXX"}</p>
                            </div>
                        </div>
                    `;
                    if (bar.address && bar.name) {
                        displayGPS(bar.address, bar);
                    }
                } else {
                    const listHtml = `
                        <div class="flex flex-col gap-4 max-w-sm mx-auto">
                            ${barsWithCoords
                                .map((bar) => {
                                    let currentColorClass = "bg-secondaire";

                                    if (bar.themes === "danse") {
                                        currentColorClass = "bg-tonique";
                                    } else if (bar.themes === "chill") {
                                        currentColorClass =
                                            "bg-secondaire-dark";
                                    }

                                    return `
                                        <div 
                                            class="${currentColorClass} p-4 rounded-2xl shadow-lg text-white cursor-pointer"
                                            data-lat="${bar.coords?.lat}"
                                            data-lon="${bar.coords?.lon}"
                                        >
                                            <h3 class="text-2xl">${bar.name}</h3>
                                            <p>${bar.address}</p>
                                        </div>
                                    `;
                                })
                                .join("")}
                        </div>
                    `;

                    barsContainer.innerHTML = listHtml;
                    barsContainer.addEventListener("click", (e) => {
                        const target = e.target.closest("[data-lat]");
                        if (!target) return;

                        const lat = parseFloat(target.getAttribute("data-lat"));
                        const lon = parseFloat(target.getAttribute("data-lon"));

                        setDestination(lat, lon);
                    });
                    if (bars.length >= 1) {
                        const firstBar = bars[0];

                        if (firstBar.address && firstBar) {
                            displayGPS(firstBar.address, firstBar);
                        }
                    }
                }
            }

            const participantsList =
                document.getElementById("participants-list");
            const searchFriendsInput = document.getElementById(
                "search-friends-input",
            ) as HTMLInputElement;
            const accordionContent = document.getElementById(
                "friends-accordion-content",
            );
            const accordionArrow = document.getElementById("accordion-arrow");
            const friendsListEl = document.getElementById("friends-list");

            const participants = soiree.expand?.members || [];
            const myFriends = await getFriendList(currentUser.id);

            // Modale de confirmation
            function askConfirmation(
                title: string,
                message: string,
                isDanger = false,
            ): Promise<boolean> {
                return new Promise((resolve) => {
                    const modal = document.getElementById(
                        "custom-confirm-modal",
                    );
                    const modalContent = modal?.querySelector("div");
                    const modalTitle = document.getElementById("modal-title");
                    const modalMessage =
                        document.getElementById("modal-message");
                    const confirmBtn =
                        document.getElementById("modal-confirm-btn");
                    const cancelBtn =
                        document.getElementById("modal-cancel-btn");

                    if (
                        !modal ||
                        !modalTitle ||
                        !modalMessage ||
                        !confirmBtn ||
                        !cancelBtn
                    ) {
                        resolve(false);
                        return;
                    }

                    modalTitle.textContent = title;
                    modalMessage.textContent = message;

                    if (isDanger) {
                        confirmBtn.className =
                            "px-5 py-2.5 bg-red-500 hover:bg-red-400 text-white rounded-xl font-bold transition text-sm";
                    } else {
                        confirmBtn.className =
                            "px-5 py-2.5 bg-green-400 hover:bg-green-300 text-black rounded-xl font-bold transition text-sm";
                    }

                    modal.classList.remove("hidden");
                    setTimeout(
                        () => modalContent?.classList.remove("scale-95"),
                        10,
                    );

                    const cleanUp = (result: boolean) => {
                        modalContent?.classList.add("scale-95");
                        modal.classList.add("hidden");
                        confirmBtn.removeEventListener("click", onConfirm);
                        cancelBtn.removeEventListener("click", onCancel);
                        resolve(result);
                    };

                    function onConfirm() {
                        cleanUp(true);
                    }
                    function onCancel() {
                        cleanUp(false);
                    }

                    confirmBtn.addEventListener("click", onConfirm);
                    cancelBtn.addEventListener("click", onCancel);
                });
            }

            // Gestion des participants
            async function renderParticipants() {
                const classement = await getClassement(id);
                if (!participantsList) return;

                if (participants.length === 0) {
                    participantsList.innerHTML = `
            <li class="text-gray-400 text-center italic py-2">
                Aucun participant trouvé
            </li>
        `;
                    return;
                }

                const sortedParticipants = [...participants].sort((a, b) => {
                    const pointsA = classement?.users?.[a.id]?.points || 0;
                    const pointsB = classement?.users?.[b.id]?.points || 0;
                    return pointsB - pointsA;
                });
                participantsList.innerHTML = sortedParticipants
                    .map((user) => {
                        const isUserLeader = soiree.leader === user.id;
                        const isUserSam = soiree.sam === user.id;
                        const showOptionsBtn = isLeader;
                        const isMe = user.id === currentUser.id;

                        const points =
                            classement?.users?.[user.id]?.points || 0;
                        console.log(points);
                        return `
                <li class="relative flex items-center justify-between gap-4 max-w-sm mx-auto w-full">
                    
                    <div class="flex-1 flex items-center justify-between page-btn font-semibold px-4 py-3 bg-white/5 rounded-xl border border-white/10">

                        <div class="flex items-center gap-3 min-w-0">

                            <div class="flex items-center justify-center min-w-[42px] h-[42px] rounded-xl bg-tonique text-white font-extrabold shadow-lg">
                                ${points}
                            </div>

                            <div class="flex flex-col min-w-0">
                                <a
                                    href="/social/${user.id}"
                                    class="truncate hover:text-tonique transition font-bold"
                                >
                                    ${user.tag}${isMe ? " (Moi)" : ""}
                                </a>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 shrink-0 ml-2">
                            <div
                                class="text-xl select-none transition-opacity duration-200 ${
                                    isUserLeader ? "opacity-100" : "opacity-30"
                                }"
                                title="Créateur"
                            >
                                <img src="/leader.svg" alt="leader icon"/>
                            </div>

                            <div
                                class="text-xl select-none transition-opacity duration-200 ${
                                    isUserSam ? "opacity-100" : "opacity-30"
                                }"
                                title="SAM"
                            >
                                <img src="/sam.svg" alt="sam icon"/>
                            </div>
                        </div>
                    </div>

                    ${
                        showOptionsBtn
                            ? `
                        <button
                            data-user-id="${user.id}"
                            class="participant-options-btn text-white text-2xl font-bold hover:text-tonique transition px-2 tracking-widest active:scale-90"
                        >
                            •••
                        </button>

                        <div
                            id="dropdown-${user.id}"
                            class="hidden absolute right-0 top-12 z-20 bg-dominante border border-tonique/30 rounded-xl p-2 shadow-2xl flex flex-col gap-1 w-48 text-sm"
                        >
                            <button
                                data-action="set-sam"
                                data-user-id="${user.id}"
                                class="text-left px-3 py-2 rounded-lg hover:bg-white/10 text-tonique transition"
                            >
                                Nommer SAM
                            </button>

                            ${
                                !isMe
                                    ? `
                                <button
                                    data-action="set-leader"
                                    data-user-id="${user.id}"
                                    class="text-left px-3 py-2 rounded-lg hover:bg-white/10 text-secondaire transition"
                                >
                                    Nommer Créateur
                                </button>

                                <div class="border-t border-white/10 my-1"></div>

                                <button
                                    data-action="kick"
                                    data-user-id="${user.id}"
                                    class="text-left px-3 py-2 rounded-lg hover:bg-red-500/20 text-red-400 transition"
                                >
                                    Retirer de la soirée
                                </button>
                            `
                                    : ""
                            }
                        </div>
                    `
                            : ""
                    }
                </li>
            `;
                    })
                    .join("");

                setupParticipantsEvents();
            }

            function setupParticipantsEvents() {
                document
                    .querySelectorAll(".participant-options-btn")
                    .forEach((btn) => {
                        btn.addEventListener("click", (e) => {
                            e.stopPropagation();
                            const userId = (
                                e.currentTarget as HTMLButtonElement
                            ).getAttribute("data-user-id");
                            const targetDropdown = document.getElementById(
                                `dropdown-${userId}`,
                            );

                            document
                                .querySelectorAll("[id^='dropdown-']")
                                .forEach((el) => {
                                    if (el !== targetDropdown)
                                        el.classList.add("hidden");
                                });

                            targetDropdown?.classList.toggle("hidden");
                        });
                    });

                document.querySelectorAll("[data-action]").forEach((btn) => {
                    btn.addEventListener("click", async (e) => {
                        const target = e.currentTarget as HTMLButtonElement;
                        const action = target.getAttribute("data-action");
                        const targetUserId =
                            target.getAttribute("data-user-id");

                        if (!targetUserId || !id) return;

                        try {
                            if (action === "set-sam") {
                                await updateEventSam(id, targetUserId);
                                window.location.reload();
                            } else if (action === "set-leader") {
                                const confirmed = await askConfirmation(
                                    "Transférer la propriété",
                                    "Êtes-vous sûr de vouloir transférer la propriété de la soirée ? Vous perdrez vos privilèges de créateur.",
                                    false,
                                );
                                if (confirmed) {
                                    await updateEventLeader(id, targetUserId);
                                    window.location.reload();
                                }
                            } else if (action === "kick") {
                                const confirmed = await askConfirmation(
                                    "Retirer le participant",
                                    "Êtes-vous sûr de vouloir retirer ce participant de la soirée ?",
                                    true,
                                );
                                if (confirmed) {
                                    await removeParticipantFromEvent(
                                        id,
                                        targetUserId,
                                    );
                                    window.location.reload();
                                }
                            }
                        } catch (err) {
                            console.error(err);
                            alert(
                                "Une erreur est survenue lors de l'application des modifications.",
                            );
                        }
                    });
                });
            }

            // Gestion de l'accordéon d'amis
            function renderFriendsAccordion(filterQuery = "") {
                if (!friendsListEl) return;

                let invitableFriends = myFriends.filter(
                    (friend) => !participants.some((p) => p.id === friend.id),
                );

                if (filterQuery) {
                    invitableFriends = invitableFriends.filter((friend) => {
                        const name = (
                            friend.tag ||
                            friend.username ||
                            ""
                        ).toLowerCase();
                        return name.includes(filterQuery.toLowerCase());
                    });
                }

                if (invitableFriends.length === 0) {
                    friendsListEl.innerHTML = `<li class="text-gray-400 text-center italic py-3 text-sm">Aucun ami disponible</li>`;
                    return;
                }

                friendsListEl.innerHTML = invitableFriends
                    .map(
                        (friend) => `
                        <li class="flex items-center justify-between bg-white/5 hover:bg-white/10 p-3 rounded-xl transition">
                            <span class="text-white font-bold">${friend.tag || friend.username}</span>
                            <button 
                                data-friend-id="${friend.id}"
                                class="add-friend-btn action-btn text-white font-semibold"
                            >
                                Ajouter
                            </button>
                        </li>
                    `,
                    )
                    .join("");

                document.querySelectorAll(".add-friend-btn").forEach((btn) => {
                    btn.addEventListener("click", async (e) => {
                        const target = e.currentTarget as HTMLButtonElement;
                        const friendId = target.getAttribute("data-friend-id");
                        if (!friendId || !id) return;

                        try {
                            target.setAttribute("disabled", "true");
                            target.textContent = "...";

                            await addParticipantToEvent(id, friendId);
                            window.location.reload();
                        } catch (err: any) {
                            console.error(err);
                            alert("Impossible d'ajouter cet ami à la soirée.");
                            target.removeAttribute("disabled");
                            target.textContent = "Ajouter";
                        }
                    });
                });
            }

            await renderParticipants();
            renderFriendsAccordion();

            const openAccordion = () => {
                accordionContent?.classList.remove("hidden");
                accordionArrow?.classList.add("rotate-180");
            };

            searchFriendsInput?.addEventListener("focus", openAccordion);
            searchFriendsInput?.addEventListener("click", openAccordion);

            searchFriendsInput?.addEventListener("input", (e) => {
                openAccordion();
                const target = e.target as HTMLInputElement;
                renderFriendsAccordion(target.value.trim());
            });

            // Événements globaux du document
            document.addEventListener("click", (e) => {
                const target = e.target as HTMLElement;

                if (
                    !searchFriendsInput?.contains(target) &&
                    !accordionContent?.contains(target)
                ) {
                    accordionContent?.classList.add("hidden");
                    accordionArrow?.classList.remove("rotate-180");
                }

                if (!target.classList.contains("participant-options-btn")) {
                    document
                        .querySelectorAll("[id^='dropdown-']")
                        .forEach((el) => {
                            el.classList.add("hidden");
                        });
                }
            });
        } catch (err) {
            console.error(err);
        }
    }

    startChallengeWatcher(id);
    init();
</script>
